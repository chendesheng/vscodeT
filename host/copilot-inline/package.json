{
  "name": "copilot-inline",
  "publisher": "minecode",
  "displayName": "GitHub Copilot Inline Completions",
  "version": "1.0.0",
  "engines": { "vscode": "^1.147.0" },
  "enabledApiProposals": ["inlineCompletionsAdditions"],
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage"],
  "contributes": {
    "commands": [
      { "command": "minecode.copilot.signIn", "title": "Sign In", "category": "GitHub Copilot" },
      { "command": "minecode.copilot.signOut", "title": "Sign Out", "category": "GitHub Copilot" }
    ]
  }
}
